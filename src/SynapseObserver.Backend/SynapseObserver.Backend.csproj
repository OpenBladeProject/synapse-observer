<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../artifacts/native/SynapseObserver.Native.dll" Link="SynapseObserver.Native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="../../artifacts/native/NativePayload.g.cs" Link="NativePayload.g.cs" />
    <ProjectReference Include="../SynapseObserver.Core/SynapseObserver.Core.csproj" />
  </ItemGroup>
  <Target Name="RequireNativePayload" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('../../artifacts/native/NativePayload.g.cs') Or !Exists('../../artifacts/native/SynapseObserver.Native.dll')" Text="Build the matching native payload first: powershell.exe -NoProfile -ExecutionPolicy Bypass -File build/Build-NativeObserver.ps1 -RunTests" />
  </Target>
</Project>

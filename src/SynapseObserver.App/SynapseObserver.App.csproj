<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Brand/OpenBlade.ico</ApplicationIcon>
    <AssemblyName>SynapseObserver</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SynapseObserver.App.Tests" />
    <Resource Include="Assets/Brand/OpenBlade.ico" />
    <Resource Include="Assets/Brand/OpenBlade.png" />
    <ProjectReference Include="../SynapseObserver.Core/SynapseObserver.Core.csproj" />
    <ProjectReference Include="../SynapseObserver.Backend/SynapseObserver.Backend.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../artifacts/native/SynapseObserver.Native.dll" Link="SynapseObserver.Native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

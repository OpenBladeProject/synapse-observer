<Window x:Class="SynapseObserver.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SynapseObserver.App" Title="Synapse Observer" Style="{StaticResource {x:Type Window}}" Width="640" Height="420" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterScreen" Icon="Assets/Brand/OpenBlade.ico">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
  </Window.Resources>
  <Grid Margin="20,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Margin="40,0,0,0">
        <TextBlock Text="Synapse Observer" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Collect evidence to help add Blade support" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
      </StackPanel>
      <Image Source="Assets/Brand/OpenBlade.png" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0" />
      <Border Grid.Column="1" Background="{StaticResource ButtonBrush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Top" Margin="12,4,0,0"><TextBlock Text="{Binding VersionLabel}" ToolTip="{Binding BuildVersion}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" /></Border>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
      <StackPanel>
        <Border Style="{StaticResource Card}" Visibility="{Binding ShowInventoryScreen, Converter={StaticResource VisibleWhenTrue}}">
          <StackPanel>
            <TextBlock Text="Your laptop" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DeviceSummary}" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,12" />
            <Button Content="{Binding CollectButtonText}" Command="{Binding CollectCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" AutomationProperties.HelpText="Read device information without sending a firmware command." />
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0" Visibility="{Binding IsCollecting, Converter={StaticResource VisibleWhenTrue}}" />
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding DeviceSummary}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" Visibility="{Binding HasInventory, Converter={StaticResource VisibleWhenTrue}}" />
        <Border Style="{StaticResource Card}" Visibility="{Binding HasInventory, Converter={StaticResource VisibleWhenTrue}}">
          <StackPanel>
            <TextBlock Text="Record Synapse changes" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{Binding RecorderStatus}" Margin="0,8,0,10" Foreground="{StaticResource MutedTextBrush}" FontSize="12" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Visibility="{Binding ShowAttach, Converter={StaticResource VisibleWhenTrue}}">
              <CheckBox Content="Allow observation of Synapse during this session" IsChecked="{Binding AttachConsent}" Margin="0,0,0,12" AutomationProperties.HelpText="The collector loads a fixed observer into a verified Synapse process. It records control feature calls without replaying them." />
              <Button Content="Start recording" Command="{Binding StartCommand}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <StackPanel Visibility="{Binding HasInventory, Converter={StaticResource VisibleWhenTrue}}">
              <Label Content="Choose an evidence item" Target="{Binding ElementName=ActivityPicker}" Padding="0,6,0,6" />
              <ComboBox x:Name="ActivityPicker" ItemsSource="{Binding Activities}" SelectedIndex="{Binding SelectedActivityIndex}" DisplayMemberPath="DisplayLabel" IsEnabled="{Binding CanSelectActivity}" MinHeight="34" Padding="8,5" MaxDropDownHeight="280" AutomationProperties.Name="Evidence item" AutomationProperties.HelpText="Choose any item. Finish restoring a changed setting before choosing another." />
              <TextBlock Text="{Binding CapacitySummary}" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
              <TextBlock Text="{Binding CoverageSummary}" Margin="0,8,0,10" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
              <Border Background="{StaticResource BackgroundBrush}" CornerRadius="5" Padding="12" Margin="0,4,0,12">
                <StackPanel>
                  <TextBlock Text="{Binding StepTitle}" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ActivityGuidance}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,8,0,0" />
                  <TextBlock Text="{Binding StepInstructions}" Margin="0,8,0,12" />
                  <StackPanel Visibility="{Binding ShowStartingValue, Converter={StaticResource VisibleWhenTrue}}">
                    <Label Content="{Binding StartingValueLabel}" Target="{Binding ElementName=StartingSettingBox}" Padding="0,0,0,6" />
                    <local:SettingEntryView x:Name="StartingSettingBox" DataContext="{Binding StartingEntry}" Tag="{Binding DataContext.StartingValueLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                  </StackPanel>
                  <StackPanel Visibility="{Binding ShowChangedValue, Converter={StaticResource VisibleWhenTrue}}">
                    <Label Content="Changed setting" Target="{Binding ElementName=ChangedSettingBox}" Padding="0,0,0,6" />
                    <local:SettingEntryView x:Name="ChangedSettingBox" DataContext="{Binding ChangedEntry}" Tag="Changed setting" />
                  </StackPanel>
                  <TextBlock Text="{Binding StepStatus}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
                  <WrapPanel Visibility="{Binding HasCurrentStep, Converter={StaticResource VisibleWhenTrue}}">
                    <Button Content="{Binding MarkButtonText}" Command="{Binding MarkCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Skip" Command="{Binding SkipCommand}" />
                    <Button Content="Setting unavailable" Command="{Binding UnavailableCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <WrapPanel Visibility="{Binding IsRecording, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock Text="{Binding ObservationSummary}" VerticalAlignment="Center" Margin="0,0,20,0" />
              </WrapPanel>
            </StackPanel>
            <Expander Header="Collection details" Margin="0,12,0,0">
              <TextBlock Text="{Binding CollectionDetails}" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" />
            </Expander>
            <Button Content="Check recording availability" Command="{Binding CollectCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="{Binding ShowAttach, Converter={StaticResource VisibleWhenTrue}}" />
          </StackPanel>
        </Border>
        <Border x:Name="SpecialKeyCard" Style="{StaticResource Card}" Visibility="{Binding ShowSpecialKeyProbe, Converter={StaticResource VisibleWhenTrue}}">
          <Expander Header="Optional M / Fn key check" IsExpanded="{Binding IsSpecialKeyActivity, Mode=OneWay}">
            <StackPanel Margin="0,10,0,0">
              <TextBlock Text="Choose Fn alone or the exact Fn chord you want to check. Note the current setting first. Keep this window active for five seconds, then restore any changed setting. Ordinary typing is omitted." Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
              <WrapPanel Margin="0,10,0,0" IsEnabled="{Binding CanChooseSpecialKey}">
                <StackPanel Margin="0,0,12,8"><Label Content="Key to press" Padding="0,0,0,5" Target="{Binding ElementName=SpecialKeyPicker}" /><ComboBox x:Name="SpecialKeyPicker" ItemsSource="{Binding SpecialKeyChoices}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding ExpectedSpecialKey}" Width="125" MinHeight="34" AutomationProperties.Name="Key to press" /></StackPanel>
              </WrapPanel>
              <TextBlock Text="{Binding SpecialKeyStatus}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />
              <WrapPanel><Button Content="Check key for 5 seconds" Command="{Binding ProbeSpecialKeyCommand}" Style="{StaticResource PrimaryButton}" /><Button Content="Cancel key check" Command="{Binding CancelSpecialKeyProbeCommand}" Visibility="{Binding IsProbingSpecialKey, Converter={StaticResource VisibleWhenTrue}}" /></WrapPanel>
            </StackPanel>
          </Expander>
        </Border>
        <Border x:Name="ExportCard" Style="{StaticResource Card}" Visibility="{Binding ShowExport, Converter={StaticResource VisibleWhenTrue}}">
          <StackPanel>
            <TextBlock Text="Review your collection" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ReviewSummary}" Margin="0,10,0,0" />
            <StackPanel Visibility="{Binding ShowCapacityRecovery, Converter={StaticResource VisibleWhenTrue}}" Margin="0,12,0,0">
              <TextBlock Text="Recording stopped early. Save the partial evidence after cleanup." />
              <CheckBox x:Name="CapacityRestorationCheckBox" IsChecked="{Binding CapacityRestorationConfirmed}" IsEnabled="{Binding CanConfirmCapacityRestoration}" Visibility="{Binding CapacityRestorationRequired, Converter={StaticResource VisibleWhenTrue}}" Margin="0,10,0,0"><TextBlock Text="{Binding CapacityRestorationLabel}" TextWrapping="Wrap" /></CheckBox>
              <TextBlock Text="A restoration reported after recording stopped is saved separately; it does not complete the earlier recording." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,8,0,0" />
            </StackPanel>
            <Button x:Name="SaveEvidenceButton" Margin="0,12,0,0" Content="Save evidence ZIP…" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" />
            <TextBlock Text="Attach the saved ZIP to your support request. Nothing is uploaded automatically." Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0" FontSize="12" />
            <Expander Header="What is missing?" Margin="0,12,0,0"><TextBlock Text="{Binding ReviewNotes}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,8,0,0" /></Expander>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
      <DockPanel>
        <Button Content="Stop recording" Command="{Binding StopCommand}" DockPanel.Dock="Right" Visibility="{Binding IsRecording, Converter={StaticResource VisibleWhenTrue}}" />
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="12" AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
    </Border>
  </Grid>
</Window>

<Window x:Class="SynapseObserver.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Synapse Observer" Style="{StaticResource {x:Type Window}}" Width="820" Height="740" MinWidth="680" MinHeight="620" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
  </Window.Resources>
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,24">
      <DockPanel>
        <TextBlock Text="SYNAPSE OBSERVER" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
        <TextBlock Text="Prototype · local collection" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" FontSize="13" />
      </DockPanel>
      <TextBlock Text="Help add support for your Blade" FontSize="28" FontWeight="SemiBold" Margin="0,16,0,8" />
      <TextBlock Text="Collect device information, record a few changes in Synapse, and share one ZIP." Foreground="{StaticResource MutedTextBrush}" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
      <StackPanel>
        <Border Style="{StaticResource Card}" Visibility="{Binding ShowInventoryScreen, Converter={StaticResource VisibleWhenTrue}}">
          <StackPanel>
            <TextBlock Text="1  Your laptop" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DeviceSummary}" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,16" />
            <Button Content="{Binding CollectButtonText}" Command="{Binding CollectCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" AutomationProperties.HelpText="Read device information without sending a firmware command." />
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0" Visibility="{Binding IsCollecting, Converter={StaticResource VisibleWhenTrue}}" />
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding DeviceSummary}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16" Visibility="{Binding HasInventory, Converter={StaticResource VisibleWhenTrue}}" />
        <Border Style="{StaticResource Card}" Visibility="{Binding HasInventory, Converter={StaticResource VisibleWhenTrue}}">
          <StackPanel>
            <TextBlock Text="2  Record changes in Synapse" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding RecorderStatus}" Margin="0,12,0,12" Foreground="{StaticResource MutedTextBrush}" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Visibility="{Binding ShowAttach, Converter={StaticResource VisibleWhenTrue}}">
              <CheckBox Content="Allow observation of Synapse during this session" IsChecked="{Binding AttachConsent}" Margin="0,0,0,12" AutomationProperties.HelpText="The prototype loads a fixed observer into a verified Synapse process. It records control feature calls without replaying them." />
              <Button Content="Start recording" Command="{Binding StartCommand}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <StackPanel Visibility="{Binding IsRecording, Converter={StaticResource VisibleWhenTrue}}">
              <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="16" Margin="0,4,0,12">
                <StackPanel>
                  <TextBlock Text="{Binding StepTitle}" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding StepInstructions}" Margin="0,8,0,12" />
                  <StackPanel Visibility="{Binding ShowStartingValue, Converter={StaticResource VisibleWhenTrue}}">
                    <Label Content="Starting setting" Target="{Binding ElementName=StartingSettingBox}" Padding="0,0,0,6" />
                    <TextBox x:Name="StartingSettingBox" Text="{Binding StartingSetting, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Padding="10" Margin="0,0,0,12" AutomationProperties.Name="Starting setting" />
                  </StackPanel>
                  <StackPanel Visibility="{Binding ShowChangedValue, Converter={StaticResource VisibleWhenTrue}}">
                    <Label Content="Changed setting" Target="{Binding ElementName=ChangedSettingBox}" Padding="0,0,0,6" />
                    <TextBox x:Name="ChangedSettingBox" Text="{Binding ChangedSetting, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Padding="10" Margin="0,0,0,12" AutomationProperties.Name="Changed setting" />
                  </StackPanel>
                  <TextBlock Text="{Binding StepStatus}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
                  <WrapPanel>
                    <Button Content="{Binding MarkButtonText}" Command="{Binding MarkCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Skip" Command="{Binding SkipCommand}" />
                    <Button Content="Setting unavailable" Command="{Binding UnavailableCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <WrapPanel>
                <TextBlock Text="{Binding ObservationSummary}" VerticalAlignment="Center" Margin="0,0,20,0" />
              </WrapPanel>
            </StackPanel>
            <Expander Header="Collection details" Margin="0,16,0,0">
              <TextBlock Text="{Binding CollectionDetails}" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" />
            </Expander>
            <Button Content="Check recording availability" Command="{Binding CollectCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="{Binding ShowAttach, Converter={StaticResource VisibleWhenTrue}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Visibility="{Binding ShowExport, Converter={StaticResource VisibleWhenTrue}}">
          <StackPanel>
            <TextBlock Text="3  Save your evidence" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ExportSummary}" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,16" />
            <Button Content="Save evidence ZIP…" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" />
            <TextBlock Text="Attach the saved ZIP to your support request. Nothing is uploaded automatically." Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0" FontSize="13" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
      <DockPanel>
        <Button Content="Stop recording" Command="{Binding StopCommand}" DockPanel.Dock="Right" Visibility="{Binding IsRecording, Converter={StaticResource VisibleWhenTrue}}" />
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
    </Border>
  </Grid>
</Window>

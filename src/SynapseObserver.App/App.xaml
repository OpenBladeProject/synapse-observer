<Application x:Class="SynapseObserver.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F3F5F7" />
    <SolidColorBrush x:Key="TextBrush" Color="#17212B" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#4A5865" />
    <SolidColorBrush x:Key="AccentBrush" Color="#14613A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#CBD3DA" />
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="20,12" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
  </Application.Resources>
</Application>
